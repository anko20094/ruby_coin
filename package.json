{
  "name": "ruby_coin",
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "8.0.23",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap5-toggle": "^5.4.1",
    "esbuild": "^0.28.2",
    "sass": "^1.103.1",
    "tinymce": "^8.8.2",
    "tom-select": "^2.6.2"
  },
  "scripts": {
    "build": "node bin/copy_tinymce.mjs && esbuild app/javascript/*.* --bundle --minify --outdir=app/assets/builds --public-path=assets",
    "build:css": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css ./app/assets/stylesheets/theme.scss:./app/assets/builds/theme.css ./app/assets/stylesheets/admin.scss:./app/assets/builds/admin.css ./app/assets/stylesheets/editor_content.scss:./app/assets/builds/editor_content.css --style=compressed --no-source-map --load-path=node_modules --quiet-deps --silence-deprecation=import,if-function,global-builtin,color-functions",
    "build:dev": "node bin/copy_tinymce.mjs && esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --public-path=assets",
    "build:css:dev": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css ./app/assets/stylesheets/theme.scss:./app/assets/builds/theme.css ./app/assets/stylesheets/admin.scss:./app/assets/builds/admin.css ./app/assets/stylesheets/editor_content.scss:./app/assets/builds/editor_content.css --no-source-map --load-path=node_modules --quiet-deps --silence-deprecation=import,if-function,global-builtin,color-functions",
    "build:tinymce": "node bin/copy_tinymce.mjs"
  },
  "packageManager": "yarn@4.18.0"
}
