section.pf-block.pf-block--career
  = render TrackTagComponent.new(label: t('profile.career'), tone: :soft, heading: :h2)
  .pf-career
    - cv.experience.each do |entry|
      .pf-career__entry
        .pf-career__head
          / A heading, not a div: heading navigation is how a screen-reader user skims a CV.
          h3.pf-career__org
            = rich(entry[:org])
            - if entry[:title].present?
              span.pf-career__title
                = ' · '
                = rich(entry[:title])
          .pf-career__when
            = entry[:period]
            - if entry[:place].present?
              br
              = rich(entry[:place])
        - if entry[:note].present?
          .pf-career__note= rich(entry[:note])
        - if entry[:body].present?
          .pf-career__body= rich(entry[:body])
        - entry_cases = cases_for(entry)
        - if entry_cases.any?
          / The entry states the job, the chips point at the evidence.
          .pf-career__cases
            - entry_cases.each do |kase|
              = link_to helpers.work_case_path(slug: kase.slug), class: 'rc-chip rc-chip--link hover-link' do
                = "#{kase.mark} #{plain(kase.title)} "
                span aria-hidden="true" →
