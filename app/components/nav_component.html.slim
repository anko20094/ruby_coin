nav.rc-nav data-controller="nav" data-action="keydown@window->nav#escape click@window->nav#outside"
  = link_to helpers.root_path, class: 'rc-nav__brand' do
    = render GemComponent.new(uid: 'nav')
    span.rc-nav__wordmark rubyco.in

  / Below 760px the sections and the locale switcher live in a drawer, which is what §10 asks
  / for — before this the nav simply wrapped onto a second row and ate 85px of every phone
  / screen. The button is hidden on wide screens by CSS, not by JavaScript, so a narrow window
  / without JS still gets a menu that is open rather than one that cannot be opened.
  button.rc-nav__toggle[type="button" data-nav-target="toggle" data-action="nav#toggle"
                        aria-expanded="false" aria-controls="rc-nav-drawer"]
    span.rc-nav__toggle-label= t('work.nav.menu')
    span.rc-nav__burger aria-hidden="true"
      span
      span

  #rc-nav-drawer.rc-nav__drawer data-nav-target="drawer"
    .rc-nav__sections
      - sections.each do |section|
        = link_to section.label, section.path, class: "rc-nav__link #{'is-current' if current?(section)}",
          aria: { current: ('page' if current_page?(section)) }

    .rc-nav__tools
      = link_to t('work.nav.cv'), helpers.cv_path, title: t('work.nav.cv_title'),
        class: "rc-nav__cv #{'is-current' if cv_current?}",
        aria: { current: ('page' if cv_current?) }
      = render 'shared/palette'

    .rc-nav__locales
      - locales.each do |locale|
        = link_to locale.upcase, helpers.url_for(request.query_parameters.merge(locale: locale)),
          class: "rc-nav__locale #{'is-current' if current_locale?(locale)}",
          lang: locale, hreflang: locale,
          aria: { current: ('true' if current_locale?(locale)) }
