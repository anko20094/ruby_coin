- content_for :title, full_title(t('home.index.tagline'))
- page_meta description: "#{t('home.index.lede_1', count: @projects_count)} #{t('home.index.lede_2')}"

.hm-page
  / Hero. The copy is the studio's, and every number in it is counted rather than typed: the
  / projects come from the portfolio, the headcount from the roster, the year from the oldest
  / case. The claims inside the lede are the owner's own aggregates.
  section.hm-hero
    .hm-hero__copy
      .hm-hero__eyebrow
        span.hm-hero__rule
        = t('home.index.eyebrow')
      h1.hm-hero__title
        = t('home.index.headline_lead')
        / An authored line break rather than a <br>: above 1000px it breaks the line without
        / adding a row, below it becomes an ordinary space and the headline re-wraps.
        span.hero-br= ' '
        - if t('home.index.headline_join').present?
          = "#{t('home.index.headline_join')} "
        span.hm-hero__mark= t('home.index.headline_mark')
        = '.'
      p.hm-hero__lede
        = t('home.index.lede_1', count: @projects_count)
        br
        = t('home.index.lede_2')
      .hm-hero__actions
        = link_to t('home.index.work_with_us'), contact_path, class: 'rc-button rc-button--primary'
        = link_to t('home.index.see_work'), work_path, class: 'rc-button'
      .hm-hero__note
        = t('home.index.stats', products: t('counts.products', count: @projects_count),
                                people: @people.size, year: @first_year)

    .hm-hero__gem
      = render GemComponent.new(uid: 'home-hero', variant: :hero)
      .hm-hero__caption
        span aria-hidden="true" ↳
        = " #{t('home.index.move_cursor')}"

  / Latest entry — the featured post if one is flagged, otherwise simply the newest.
  - if @latest.present?
    section.hm-latest
      .rc-eyebrow= t('home.index.latest')
      = link_to post_path(@latest), class: 'hm-latest__entry' do
        .hm-latest__cover
          - if @latest.photo.present?
            = image_tag @latest.photo.medium.url, alt: '', loading: 'lazy'
        .hm-latest__body
          .hm-latest__meta= [@latest.created_at.strftime('%Y·%m·%d'), journal_byline(@latest, tags: false)].compact_blank.join(' · ')
          h2.hm-latest__title= @latest.title
          .rc-chips
            - @latest.tags.first(3).each do |tag|
              span.rc-chip= "##{tag.title}"
          .hm-latest__more
            = "#{t('home.index.read_full')} "
            span aria-hidden="true" →

  section.hm-grid
    - if @cases.any?
      .hm-work
        .rc-eyebrow= t('home.index.recent_work')
        .hm-cards
          - @cases.each do |kase|
            = link_to work_case_path(slug: kase.slug), class: 'hm-card' do
              .hm-card__cover
                span.hm-card__glyph= kase.mark
              h3.hm-card__title= rich(kase.title.to_s.gsub(' · ', '&nbsp;· '), links: false)
              .hm-card__mark= kase.mark
              .hm-card__meta= "#{kase.sector} · #{kase.year}"
              .hm-card__tagline= rich(kase.tagline, links: false)
        = link_to work_path, class: 'hm-more' do
          = "#{t('home.index.all_work')} "
          span aria-hidden="true" →

    / The third surface showing the roster, after /studio and /team, and it reads the same file
    / as both — a new person is one YAML entry, not three edits.
    .hm-crew
      .rc-eyebrow= t('home.index.crew')
      .hm-crew__list
        - @people.each do |person|
          = link_to person_path(person), class: 'hm-crew__row hover-row' do
            = render MonogramComponent.of(person, size: 32, ring: :mute)
            .hm-crew__who
              .hm-crew__name= person.name
              .hm-crew__role= person.role
            span.hm-crew__arrow aria-hidden="true" →
      .hm-crew__note
        = t('home.index.crew_note', people: @people.size,
                                    humans: t('counts.humans', count: @people.count { |person| !person.machine? }))

/ Fades in once the hero has scrolled away, and takes you back to it.
button.hm-top[data-controller="floating-ruby" data-action="floating-ruby#toTop" hidden=true aria-label=t('home.index.to_top')]
  = render GemComponent.new(uid: 'home-top', variant: :anchor, size: 72)
  span.hm-top__label
    span aria-hidden="true" ↑
    = " #{t('home.index.top')}"
