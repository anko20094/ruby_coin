- content_for :title, full_title(t('home.index.tagline'))
- page_meta description: @profile.summary, type: 'profile'

.hm-page
  / Hero. Every value here is real: the eyebrow and the lede come from the CV, the note counts
  / the journal. The three-line heading is the handoff's own proposed wording (§4) and lives in
  / the locale files — it is the first sentence on the site and the owner's to confirm.
  section.hm-hero
    .hm-hero__copy
      .hm-hero__eyebrow
        span.hm-hero__rule
        / The CV's location carries two parts ("Ukraine · remote"); the eyebrow wants one.
        = [@profile.name, t('home.index.eyebrow_craft'), @profile.location.to_s.split(' · ').first].compact_blank.join(' · ')
      h1.hm-hero__title
        - t('home.index.headline').each_with_index do |line, index|
          - if index == t('home.index.headline').size - 1
            = line
            = ' '
            span.hm-hero__mark= t('home.index.headline_mark')
          - else
            = line
            br
      p.hm-hero__lede= @profile.summary
      .hm-hero__actions
        = link_to t('home.index.see_work'), work_path, class: 'rc-button rc-button--primary'
        = link_to t('home.index.read_journal'), journal_path, class: 'rc-button'
      .hm-hero__note= t('home.index.entries', count: @entries_count)

    .hm-hero__gem
      = render GemComponent.new(uid: 'home-hero', variant: :hero, size: 400)
      .hm-hero__caption
        span aria-hidden="true" ↳
        = " #{t('home.index.move_cursor')}"

  / Latest entry — the featured post if one is flagged, otherwise simply the newest.
  - if @latest.present?
    section.hm-latest
      .rc-eyebrow= t('home.index.latest')
      = link_to post_path(@latest), class: 'hm-latest__entry' do
        .hm-latest__cover
          - if @latest.photo.present?
            = image_tag @latest.photo.medium.url, alt: '', loading: 'lazy'
        .hm-latest__body
          .hm-latest__meta= [@latest.created_at.strftime('%Y·%m·%d'), journal_byline(@latest)].compact_blank.join(' · ')
          h2.hm-latest__title= @latest.title
          .rc-chips
            - @latest.tags.first(3).each do |tag|
              span.rc-chip= "##{tag.title}"
          .hm-latest__more
            = "#{t('home.index.read_full')} "
            span aria-hidden="true" →

  / Recent work. The design put a crew panel beside this under Option B; there is no team data
  / yet and the handoff forbids placeholder people, so the cards run the full width — which is
  / what §4 says to do when the column is not there.
  - if @cases.any?
    section.hm-work
      .rc-eyebrow= t('home.index.recent_work')
      .hm-cards
        - @cases.each do |kase|
          = link_to work_case_path(slug: kase.slug), class: 'hm-card' do
            .hm-card__cover
              span.hm-card__glyph= kase.mark
            h3.hm-card__title== kase.title.to_s.gsub(' · ', '&nbsp;· ')
            .hm-card__mark= kase.mark
            .hm-card__meta= "#{kase.sector} · #{kase.year}"
            .hm-card__tagline= kase.tagline
      = link_to work_path, class: 'hm-more' do
        = "#{t('home.index.all_work')} "
        span aria-hidden="true" →

/ Fades in once the hero ruby has scrolled away, and takes you back to it.
button.hm-top[data-controller="floating-ruby" data-action="floating-ruby#toTop" hidden=true aria-label=t('home.index.to_top')]
  = render GemComponent.new(uid: 'home-top', variant: :anchor, size: 72)
  span.hm-top__label
    span aria-hidden="true" ↑
    = " #{t('home.index.top')}"
