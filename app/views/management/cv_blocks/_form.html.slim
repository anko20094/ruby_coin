/ One form for all three kinds: which fields it draws comes from CVBlock::SHAPES, so adding a
/ key to a shape adds it here too.
/ A rejected create re-renders this form with whatever kind was submitted, and #create does
/ not normalise it the way #new does — an unknown kind used to raise KeyError here and turn a
/ validation failure into a 500.
- shape = CVBlock::SHAPES.fetch(block.kind) { CVBlock::SHAPES.fetch(CVBlock::KINDS.first) }
= form_with model: [:management, block], scope: :cv_block do |f|
  .admin-form__content
    = render 'shared/errors', object: block
    = f.hidden_field :kind

    .row
      .col.d-grid.align-items-end
        = f.label :kind, t('.kind'), class: 'standart-label'
        .standart-label= t("management.cv_blocks.index.kinds.#{block.kind}")
      .col.d-grid.align-items-end
        = f.label :position, t('.position'), class: 'standart-label'
        = f.number_field :position, class: 'standart-input'

    - shape[:localised].each do |key|
      .case-field
        .standart-label= t(".#{key}")
        .row
          - I18n.available_locales.each do |locale|
            .col
              = f.label :"#{key}_#{locale}", t(locale).downcase, class: 'standart-label'
              - if %i[body text note].include?(key)
                = f.text_area :"#{key}_#{locale}", rows: 3, class: 'standart-input'
              - else
                = f.text_field :"#{key}_#{locale}", class: 'standart-input'

    - if shape[:plain].include?(:period)
      .case-field
        = f.label :period, t('.period'), class: 'standart-label'
        = f.text_field :period, value: block.period, class: 'standart-input'

    - if shape[:plain].include?(:items)
      .case-field
        = f.label :items_list, t('.items'), class: 'standart-label'
        = f.text_area :items_list, rows: 8, class: 'standart-input'

    - if block.kind == 'experience'
      .case-field
        = f.label :case_slugs_list, t('.case_slugs'), class: 'standart-label'
        = f.text_field :case_slugs_list, class: 'standart-input'

    .actions
      = link_to t('global.button.cancel'), management_cv_blocks_path, class: 'main-btn not_filled'
      = f.submit(block.new_record? ? t('global.button.create') : t('global.button.edit'), class: 'main-btn filled')
