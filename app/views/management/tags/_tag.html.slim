/ One form, one button, one confirmation that works without Turbo Drive.
= turbo_frame_tag tag, class: 'mg-tag-row' do
  h3.mg-tag-row__title = tag.title
  .mg-tag-row__actions
    = link_to edit_management_tag_path(tag), class: 'mg-icon-btn', data: { turbo_frame: dom_id(tag) },
      aria: { label: t('global.button.edit_item', item: tag.title) } do
      = icon(:edit)
    = button_to management_tag_path(tag), method: :delete, class: 'mg-icon-btn mg-icon-btn--danger',
      aria: { label: t('global.button.delete_item', item: tag.title) },
      form: { data: { controller: 'confirm', action: 'submit->confirm#guard',
                      confirm_message_value: t('confirmations.delete', item: tag.title) } } do
      = icon(:delete)
