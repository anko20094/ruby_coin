/ Delete used to be a div-as-button opening a Bootstrap modal whose confirm was an <a> nested
/ inside a <button>, carrying a duplicate `exampleModalLabel` id on every row — and the link
/ itself relied on data-turbo-method, which does nothing with Turbo Drive off. One form, one
/ button, one confirmation that works without Turbo.
= turbo_frame_tag tag, class: 'tag' do
  h3.tag__title = tag.title
  .tag__actions
    .edit
      = link_to edit_management_tag_path(tag), data: { turbo_frame: dom_id(tag) },
        aria: { label: t('global.button.edit_item', item: tag.title) } do
        = image_tag 'edit-icon.svg', alt: ''
    .delete
      = button_to management_tag_path(tag), method: :delete,
        aria: { label: t('global.button.delete_item', item: tag.title) },
        form: { data: { controller: 'confirm', action: 'submit->confirm#guard',
                        confirm_message_value: t('confirmations.delete', item: tag.title) } } do
        = image_tag 'delete-icon.svg', alt: ''
