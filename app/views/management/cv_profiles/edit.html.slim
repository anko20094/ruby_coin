- provide(:title, full_title(t('.title')))
.admin-form
  = form_with model: @profile, url: management_cv_profile_path, method: :patch, scope: :cv_profile do |f|
    .admin-form__content
      = render 'shared/errors', object: @profile

      - CVProfile::LOCALISED_SCALARS.each do |field|
        .case-field
          .standart-label= t(".#{field}")
          .row
            - I18n.available_locales.each do |locale|
              .col
                = f.label :"#{field}_#{locale}", t(locale).downcase, class: 'standart-label'
                - if field == :summary
                  = f.text_area :"#{field}_#{locale}", rows: 4, class: 'standart-input'
                - else
                  = f.text_field :"#{field}_#{locale}", class: 'standart-input'

      .case-field
        = f.label :figures_as_of, t('.updated_on'), class: 'standart-label'
        = f.text_field :figures_as_of, class: 'standart-input'

      / key · label · link, printed in this order in the contact column.
      .case-field
        .standart-label= t('.contact')
        - (@profile.contact_rows.size + 1).times do |index|
          - row = @profile.contact_rows[index].to_a
          .case-row-fields
            = text_field_tag "cv_profile[contact_rows][#{index}][key]", row[0], class: 'standart-input', placeholder: t('.contact_key')
            = text_field_tag "cv_profile[contact_rows][#{index}][label]", row[1], class: 'standart-input', placeholder: t('.contact_label')
            = text_field_tag "cv_profile[contact_rows][#{index}][href]", row[2], class: 'standart-input', placeholder: t('.contact_href')

      .actions
        = link_to t('global.button.cancel'), management_root_path, class: 'main-btn not_filled'
        = f.submit t('global.button.save'), class: 'main-btn filled'
