- provide(:title, full_title(t('.title')))
.admin-panel
  .admin-panel__content
    .admin-panel__inner
      = render 'management/shared/admin_left_panel'
      .admin-panel__right
        .inner-title
          h1.admin__title= t('.title')
        .cases-admin
          - @cases.each do |kase|
            .case-row
              span.case-row__mark= kase.mark
              .case-row__body
                h4.case-row__title= kase.title
                p.case-row__meta= "#{kase.slug} · #{kase.year} · #{kase.sector}"
              .case-row__flags
                - if kase.own?
                  span.case-row__flag= t('.own')
                - if kase.is_this_site?
                  span.case-row__flag= t('.this_site')
              .post__actions
                .delete
                  = link_to image_tag('delete-icon.svg'), management_case_path(kase),
                    data: { turbo_method: :delete, turbo_confirm: t('global.dialog.you_sure') }
                .edit
                  = link_to image_tag('edit-icon.svg'), edit_management_case_path(kase), data: { turbo: :false }
        .footer-panel
          = link_to t('buttons.create'), new_management_case_path, class: 'main-btn', data: { turbo: :false }
