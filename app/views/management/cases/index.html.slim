- provide(:title, full_title(t('.title')))
.admin-panel
  .admin-panel__content
    .admin-panel__inner
      .admin-panel__right
        .inner-title
          h1.admin__title= t('.title')
        .cases-admin
          - @cases.each do |kase|
            .case-row
              span.case-row__mark= kase.mark
              .case-row__body
                h4.case-row__title= kase.title
                p.case-row__meta= "#{kase.slug} · #{kase.year} · #{kase.sector}"
              .case-row__flags
                - if kase.own?
                  span.case-row__flag= t('.own')
                - if kase.is_this_site?
                  span.case-row__flag= t('.this_site')
              .post__actions
                .delete
                  = button_to management_case_path(kase), method: :delete,
                    aria: { label: t('global.button.delete') },
                    form: { data: { controller: 'confirm', action: 'submit->confirm#guard',
                                    confirm_message_value: t('global.dialog.you_sure') } } do
                    = image_tag('delete-icon.svg', alt: '')
                .edit
                  = link_to edit_management_case_path(kase), data: { turbo: :false },
                    aria: { label: t('global.button.edit') } do
                    = image_tag 'edit-icon.svg', alt: ''
        .footer-panel
          = link_to t('buttons.create'), new_management_case_path, class: 'main-btn', data: { turbo: :false }
