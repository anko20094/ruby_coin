= form_with model: [:management, kase], scope: :case do |f|
  .admin-form__content
    = render 'shared/errors', object: kase

    .row
      .col.d-grid.align-items-end
        = f.label :slug, t('.slug'), class: 'standart-label'
        = f.text_field :slug, class: 'standart-input'
      .col.d-grid.align-items-end
        = f.label :mark, t('.mark'), class: 'standart-label'
        = f.text_field :mark, class: 'standart-input'
      .col.d-grid.align-items-end
        = f.label :position, t('.position'), class: 'standart-label'
        = f.number_field :position, class: 'standart-input'

    .row
      - %i[year sector status].each do |field|
        .col.d-grid.align-items-end
          = f.label field, t(".#{field}"), class: 'standart-label'
          = f.text_field field, class: 'standart-input'

    .checkboxes
      .flex-inner
        = f.label :own, t('.own'), class: 'standart-label'
        = f.check_box :own
      .flex-inner
        = f.label :is_this_site, t('.this_site'), class: 'standart-label'
        = f.check_box :is_this_site

    / One field per language for every translated scalar. Both are required — the handoff's
    / editorial rule is that a case is never published in one language alone.
    - Case::LOCALISED_SCALARS.each do |field|
      .case-field
        .standart-label= t(".#{field}")
        .row
          - I18n.available_locales.each do |locale|
            .col
              = f.label :"#{field}_#{locale}", t(locale).downcase, class: 'standart-label'
              - if field == :scope_note
                = f.text_area :"#{field}_#{locale}", rows: 3, class: 'standart-input'
              - else
                = f.text_field :"#{field}_#{locale}", class: 'standart-input'

    .case-field
      = f.label :stack_list, t('.stack'), class: 'standart-label'
      = f.text_area :stack_list, rows: 8, class: 'standart-input'

    / Structured content. The row count comes from Case::STRUCTURES, so the form and the
    / design never drift apart; an empty row is dropped on save.
    - Case::STRUCTURES.each do |field, spec|
      .case-field
        .standart-label
          = t(".#{field}")
          span.case-field__hint= " · #{t('.expected', count: spec[:count])}"
        - case_rows_count(kase, field).times do |index|
          .case-row-fields
            - if spec[:fields].nil?
              - I18n.available_locales.each do |locale|
                = case_field_tag("case[#{field}_rows][#{index}][#{locale}]", case_row_value(kase, field, index, locale), long: true)
            - else
              - spec[:fields].each do |key, kind|
                - if kind == :localised
                  - I18n.available_locales.each do |locale|
                    = case_field_tag("case[#{field}_rows][#{index}][#{key}][#{locale}]", case_row_value(kase, field, index, key, locale), long: key == :body)
                - else
                  = case_field_tag("case[#{field}_rows][#{index}][#{key}]", case_row_value(kase, field, index, key))

    .actions
      = link_to t('global.button.cancel'), management_cases_path, class: 'main-btn not_filled'
      = f.submit(kase.new_record? ? t('global.button.create') : t('global.button.edit'), class: 'main-btn filled')
