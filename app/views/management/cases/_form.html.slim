/ The case form. The hardest screen in the project: one case is seven translated scalars, a
/ stack list and five structured fields, each of those a list of rows and each row up to four
/ values across two languages.
/
/ Two things it did not use to do. Every text field is a real editor now — the /work page
/ renders these strings as markup (ProseHelper#rich), so an author needs a way to make the
/ markup. And the structured fields are no longer fixed: Case::STRUCTURES#count says what the
/ design draws, not how many rows may exist, and rows are added, removed and reordered here.
= form_with model: [:management, kase], scope: :case do |f|
  .admin-form__content
    = render 'shared/errors', object: kase

    .row
      .col.d-grid.align-items-end
        = f.label :slug, t('.slug'), class: 'standart-label'
        = f.text_field :slug, class: 'standart-input'
      .col.d-grid.align-items-end
        = f.label :mark, t('.mark'), class: 'standart-label'
        = f.text_field :mark, class: 'standart-input'
      .col.d-grid.align-items-end
        = f.label :position, t('.position'), class: 'standart-label'
        = f.number_field :position, class: 'standart-input'

    .row
      - %i[year sector status].each do |field|
        .col.d-grid.align-items-end
          = f.label field, t(".#{field}"), class: 'standart-label'
          = f.text_field field, class: 'standart-input'

    .checkboxes
      .flex-inner
        = f.label :own, t('.own'), class: 'standart-label'
        = f.check_box :own
      .flex-inner
        = f.label :is_this_site, t('.this_site'), class: 'standart-label'
        = f.check_box :is_this_site

    / One field per language for every translated scalar. Both are required — the handoff's
    / editorial rule is that a case is never published in one language alone.
    - Case::LOCALISED_SCALARS.each do |field|
      .mg-structure
        .standart-label= t(".#{field}")
        .mg-cells
          - I18n.available_locales.each do |locale|
            .mg-cell
              label.mg-cell__label[for="case_#{field}_#{locale}"]= t(locale).downcase
              = f.text_area :"#{field}_#{locale}", rows: 2, class: 'standart-input mg-cell__rich', data: tinymce_data(profile: 'case', lazy: true)

    .mg-structure
      = f.label :stack_list, t('.stack'), class: 'standart-label'
      = f.text_area :stack_list, rows: 8, class: 'standart-input'

    / Structured content. Each field is its own little list, drawn by the shared widget the CV
    / uses too — see app/views/management/shared/_structure_section.html.slim.
    - Case::STRUCTURES.each do |field, spec|
      = render 'management/shared/structure_section', record: kase, scope: :case, field: field, spec: spec, label: t(".#{field}")

    .actions
      = link_to t('global.button.cancel'), management_cases_path, class: 'main-btn not_filled'
      / "Save", not "Edit". The button writes the form; edit is what you were already doing.
      = f.submit(kase.new_record? ? t('global.button.create') : t('global.button.save'), class: 'main-btn filled')
