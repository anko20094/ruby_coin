- content_for :title, full_title(@query.presence || t('.title'))
- page_meta description: t('.lede')

.jn-index
  header.jn-index__header
    .jn-index__intro
      .rc-eyebrow= "/#{t('.eyebrow')}"
      h1.jn-index__title
        = t('.title')
        = ' '
        span.jn-index__mark ·
      p.jn-index__lede= t('.lede')
    .jn-index__anchor
      = render GemComponent.new(uid: 'search-anchor', variant: :anchor, size: 90)

  = form_with url: search_path, method: :get, class: 'jn-search' do |f|
    .jn-search__row
      = f.label :query, t('.field'), class: 'jn-search__label'
      = f.search_field :query, value: @query, class: 'jn-search__input',
        placeholder: t('.placeholder'), autofocus: @query.blank?
      = f.submit t('.submit'), class: 'rc-button rc-button--primary'

    fieldset.jn-search__fields
      legend.jn-search__label= t('.where')
      .rc-chips
        - JournalController::SEARCH_FIELDS.each do |field|
          .jn-search__field
            = f.radio_button :search_in, field, checked: @field == field, id: "search_in_#{field}"
            = f.label :search_in, t(".fields.#{field}"), value: field, for: "search_in_#{field}"

  - if @query.blank?
    p.jn-empty= t('.prompt')
  - elsif @pagy.count.positive?
    .rc-eyebrow.jn-search__count= t('.found', count: @pagy.count)
    .jn-entries
      - @results.each_with_index do |post, index|
        = render JournalEntryComponent.new(post:, first: index.zero?)

    - if @pagy.pages > 1
      nav.jn-pager aria-label=t('.title')
        - if @pagy.previous
          = link_to search_path(query: @query, search_in: @field, page: @pagy.previous),
            class: 'jn-pager__step', aria: { label: t('journal.index.pager.previous') } do
            span aria-hidden="true" ←
        span.jn-pager__count= "#{@pagy.page} / #{@pagy.pages}"
        - if @pagy.next
          = link_to search_path(query: @query, search_in: @field, page: @pagy.next),
            class: 'jn-pager__step', aria: { label: t('journal.index.pager.next') } do
            span aria-hidden="true" →
  - else
    p.jn-empty= t('.none', query: @query)
    p.jn-search__fallback
      = link_to t('journal.post.all_entries'), journal_path, class: 'hover-link'
