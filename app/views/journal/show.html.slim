- content_for :title, full_title(@post.title)
/ A post unfurls with its own cover; only where there is none does the site card stand in.
- page_meta description: @post.subtitle, image: (@post.photo.presence && @post.photo.medium.url), type: 'article', published_at: @post.created_at, updated_at: @post.updated_at, locales: @post.translated_locales

= render 'shared/reading_progress'

article.jn-post
  .jn-post__breadcrumb
    = link_to journal_path, class: 'jn-post__back' do
      span aria-hidden="true" ←
      = " #{t('journal.post.back')}"
    - if @post.entry_label.present?
      = " · #{@post.entry_label}"
    = " · #{@post.created_at.strftime('%Y·%m·%d')}"

  h1.jn-post__title= @post.title
  .jn-post__byline= journal_byline(@post)

  - if @post.photo.present?
    / The first image on the page, so it is fetched first; the sizes are the version's, and
    / the CSS crops it, so they only reserve the box.
    .jn-post__cover
      = image_tag @post.photo.medium.url, alt: '', loading: 'eager', fetchpriority: 'high',
        width: PhotoUploader::MEDIUM.first, height: PhotoUploader::MEDIUM.last

  .jn-body
    p.jn-body__lede= @post.subtitle
    = journal_body(@post)

  / The entries either side, by series number. The journal is a numbered series and had no way
  / to read it as one: every entry's only exits were back to the index and a tag-similarity row.
  - if @previous_entry || @next_entry
    nav.jn-steps aria-label=t('journal.post.series')
      - if @previous_entry
        = link_to post_path(@previous_entry), class: 'jn-step hover-row' do
          .jn-step__eyebrow
            span aria-hidden="true" ←
            = " #{t('journal.post.previous')} #{@previous_entry.entry_label}"
          .jn-step__title= @previous_entry.title
      - else
        span

      - if @next_entry
        = link_to post_path(@next_entry), class: 'jn-step jn-step--next hover-row' do
          .jn-step__eyebrow
            = "#{t('journal.post.next')} #{@next_entry.entry_label} "
            span aria-hidden="true" →
          .jn-step__title= @next_entry.title

  footer.jn-post__footer
    = link_to journal_path, class: 'jn-post__back' do
      span aria-hidden="true" ←
      = " #{t('journal.post.all_entries')}"
    span.jn-post__number= @post.entry_label

  - if @related.any?
    section.jn-related
      = render TrackTagComponent.new(label: t('journal.post.related'), tone: :soft, heading: :h2)
      .jn-related__row
        - @related.each do |post|
          = link_to post_path(post), class: 'jn-related__card' do
            / The slot is always drawn: CarrierWave reports a cover as absent when its file is
            / missing, and one card without one should not shift the row.
            .jn-related__cover
              - if post.photo.present?
                = image_tag post.photo.small.url, alt: '', loading: 'lazy', width: PhotoUploader::SMALL.first, height: PhotoUploader::SMALL.last
            .jn-related__date= post.created_at.strftime('%Y·%m·%d')
            h3.jn-related__title= post.title
            .jn-related__tags= post.tags.first(3).map { |tag| "##{tag.title}" }.join(' ')
