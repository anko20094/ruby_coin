/ Who built it, at the foot of the case. Each card is a link to that person's one page, and
/ the project travels with it as ?from= so the page they land on opens on this contribution.
- solo = solo_contribution(team)
- label = solo ? t('work.case.team') : "#{t('work.case.team')} · #{t('counts.contributors', count: team.size)}"

section.wk-case__team
  = render TrackTagComponent.new(label: label, tone: :soft, heading: :h2)

  - if solo
    = link_to person_path(solo.person, from: slug), class: 'wk-solo hover-row' do
      = render MonogramComponent.of(solo.person, size: 72)
      .wk-solo__body
        h3.wk-solo__title= t('work.case.team_solo')
        .wk-solo__meta= [solo.person.name, solo.role, solo.period].compact_blank.join(' · ')
        = render 'people/did', lines: solo.did, dense: true
        / Commercial work had a wider team; it was the client's, and the case page already
        / prints how far down the contributor list this one name sits.
        - if solo.outside.present?
          .wk-solo__outside= rich(solo.outside)
      span.wk-solo__open
        = "#{t('work.case.open_cv')} "
        span aria-hidden="true" →
  - else
    .wk-team
      - team.each do |contribution|
        = link_to person_path(contribution.person, from: slug), class: 'wk-teammate hover-row' do
          .wk-teammate__head
            = render MonogramComponent.of(contribution.person, size: 52, ring: :mute)
            .wk-teammate__who
              h3.wk-teammate__name= contribution.person.name
              .wk-teammate__role= [contribution.role, contribution.period].compact_blank.join(' · ')
          = render 'people/did', lines: contribution.did, dense: true
