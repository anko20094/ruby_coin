- content_for :title, full_title(t('work.index.title'))
- page_meta description: @profile.summary, image: "/og/site-#{I18n.locale}.png", type: 'profile'

.wk-index
  header.wk-index__header
    .rc-eyebrow= "/#{t('work.index.eyebrow')}"
    h1.wk-index__title
      = t('work.index.title')
      = ' '
      span.wk-index__mark ·
    .wk-index__identity= [@profile.name, @profile.role, @profile.years].compact_blank.join(' · ')

  .wk-index__grid
    .wk-index__main
      p.wk-index__summary= @profile.summary

      section.wk-index__section.wk-index__section--projects
        = render TrackTagComponent.new(label: t('work.index.tracks.projects'), tone: :ruby, heading: :h2)
        p.wk-index__lede= t('work.index.lede')
        = render 'work/project_rows', cases: @cases

      section.wk-index__section.wk-index__section--career
        = render TrackTagComponent.new(label: t('work.index.tracks.career'), tone: :soft, heading: :h2)
        .wk-career
          - @experience.each do |entry|
            .wk-career__entry
              .wk-career__head
                / A heading, not a div: these are the sections of a CV, and heading navigation
                / is how a screen-reader user skims one.
                h3.wk-career__org
                  = entry.org
                  span.wk-career__title= " · #{entry.title}"
                .wk-career__when
                  = entry.period
                  br
                  = entry.place
              - if entry.note.present?
                .wk-career__note= entry.note
              - if entry.body.present?
                .wk-career__body= rich(entry.body)
              - if entry.cases.any?
                .wk-career__cases
                  - entry.cases.each do |kase|
                    = link_to work_case_path(slug: kase.slug), class: 'rc-chip rc-chip--link hover-link' do
                      = "#{kase.mark} #{kase.title} "
                      span aria-hidden="true" →

      section.wk-index__section.wk-index__section--stack
        = render TrackTagComponent.new(label: t('work.index.tracks.stack'), tone: :soft, heading: :h2)
        .wk-stack
          - @stack_groups.each do |group|
            .wk-stack__group
              .wk-stack__label= group.label
              .rc-chips
                - group.items.each do |item|
                  span.rc-chip= item
        .wk-strengths
          - @strengths.each do |strength|
            .wk-strengths__item= strength.text

    aside.wk-index__aside
      - if @profile.portrait
        .wk-portrait= image_tag @profile.portrait, alt: @profile.name
      #contact.wk-contact
        .wk-contact__label.is-ruby= t('work.index.contact')
        - @profile.contact_rows.each do |key, label, href|
          .wk-contact__row
            span.wk-contact__key= key
            = link_to label, href, class: 'wk-contact__value', target: '_blank', rel: 'noreferrer'
        .wk-contact__label= t('work.index.location')
        div= @profile.location
        .wk-contact__label= t('work.index.languages')
        div= @profile.languages
        .wk-contact__label= t('work.index.education')
        div= @profile.education
      .wk-index__footnote
        = "#{t('work.index.figures')} · #{@profile.figures_as_of}"
        br
        = t('work.index.both_halves')
