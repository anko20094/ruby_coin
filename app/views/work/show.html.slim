/ The title on its own is a mark ('DNA'), which says nothing in a search result or a tab —
/ the sector is the shortest thing that makes it a sentence.
- content_for :title, full_title([plain(@case.title), @case.sector].compact_blank.join(' · '))
- title = plain(@case.title)
- page_meta description: plain(@case.tagline), image: share_card(@case.slug), type: 'article', updated_at: @case.updated_at

= render 'shared/reading_progress'

article.wk-case data-controller="track-jump"
  header.wk-case__header
    .wk-case__breadcrumb
      = link_to work_path, class: 'hover-link' do
        span aria-hidden="true" ←
        = " #{t('work.case.back')}"
      = " · #{@case.mark} / #{format('%02d', @total)} · #{@case.sector.upcase} · #{@case.year}"
    h1.wk-case__title class=('is-long' if title.length > 14)
      = rich(@case.title)
      = ' '
      span.wk-case__title-mark= @case.mark
    p.wk-case__tagline= rich(@case.tagline)
    .wk-case__role= rich(@case.role)

    / The link that makes the two-track shape mean something: one URL for the recruiter, this
    / one for the CTO. Rendered as a real anchor so it works with JavaScript off and can be
    / copied out of the context menu; the controller only upgrades the scroll and keeps the
    / address bar honest.
    = link_to '#engineers', class: 'wk-case__skip', data: { action: 'track-jump#jump' } do
      span aria-hidden="true" ↓
      = " #{t('work.case.skip')}"

  section.wk-case__strip
    .wk-metrics
      / Each figure is a button that copies "<value> — <label>": recruiters retype these into
      / notes and messages by hand.
      - @case.metrics.each do |metric|
        / The accessible name says what pressing it does; the figure itself is the visible label.
        button.wk-metric[type="button" data-controller="copy" data-action="copy#copy"
                         data-copy-text-value="#{plain(metric[:value])} — #{plain(metric[:label])}"
                         data-copy-done-value=t('work.case.copied')
                         aria-label="#{t('work.case.copy')}: #{plain(metric[:value])} — #{plain(metric[:label])}"]
          .wk-metric__value.num= rich(metric[:value], links: false)
          .wk-metric__label= rich(metric[:label], links: false)
          span.wk-metric__flash[aria-live="polite" data-copy-target="flash"]

  section.wk-case__plain
    = render TrackTagComponent.new(label: t('work.case.plain'), tone: :ruby)
    h2.wk-case__heading= rich(@case.plain_heading)
    .wk-case__columns
      .wk-prose
        - @case.plain_body.each do |paragraph|
          p= rich(paragraph)
      aside.wk-case__panels
        .wk-panel.wk-panel--mine
          h3.wk-panel__label.is-ruby= t('work.case.mine')
          ul.wk-mine
            - @case.mine.each do |item|
              li.wk-mine__item= rich(item)
        .wk-panel.wk-panel--facts
          h3.wk-panel__label= t('work.case.facts')
          div= "#{t('work.case.status')} · #{@case.status}"
          .wk-panel__label= t('work.case.stack')
          .rc-chips
            - @case.stack.each do |item|
              span.rc-chip.rc-chip--sm= item

  section#engineers.wk-case__band tabindex="-1"
    .wk-case__band-inner
      = render TrackTagComponent.new(label: t('work.case.engineering'), tone: :soft)
      h2.wk-case__heading.is-small= rich(@case.engineering_heading)
      p.wk-case__sub= rich(@case.engineering_sub)
      .wk-cards
        - @case.engineering_items.each do |item|
          .wk-card
            h3.wk-card__title= rich(item[:title])
            .wk-card__body= rich(item[:body])
      .wk-quality
        - @case.quality.each do |metric|
          .wk-quality__cell
            .wk-quality__value.num= rich(metric[:value])
            .wk-quality__label= rich(metric[:label])
      .wk-case__scope= rich(@case.scope_note)

  - if @team.any?
    = render CaseTeamComponent.new(team: @team, slug: @case.slug)

  / The page whose job is to convince someone ended at "here is the next case". A reader who
  / has just read 2,000 words of evidence should not have to go looking for the way to say so.
  section.wk-case__cta
    p.wk-case__cta-line= t('work.case.cta')
    .wk-case__cta-links
      = link_to t('work.case.cta_contact'), contact_path, class: 'rc-button rc-button--primary'
      - email = Team.owner_cv.contact_rows.find { |key, _, _| key == 'email' }
      - if email
        = link_to email[1], email[2], class: 'rc-button'

  nav.wk-case__pager
    .wk-case__pager-label= t('work.case.pager')
    .wk-case__pager-cards
      = link_to work_case_path(slug: @previous_case.slug), class: 'wk-pager-card hover-row' do
        .wk-pager-card__eyebrow
          span aria-hidden="true" ←
          = " #{t('work.case.previous')}"
        .wk-pager-card__title= rich(@previous_case.title, links: false)
      = link_to work_case_path(slug: @next_case.slug), class: 'wk-pager-card wk-pager-card--next hover-row' do
        .wk-pager-card__eyebrow
          = "#{t('work.case.next')} "
          span aria-hidden="true" →
        .wk-pager-card__title= rich(@next_case.title, links: false)
