- content_for :title, full_title(t('buttons.forgot_password'))
- page_meta description: t('buttons.forgot_password')

.au-page.rc-scene
  .rc-glow.au-page__glow
  = render HexRingsComponent.new(css: 'au-page__rings')
  / A sheet of paper on the scene: the form stays light, where every field is easiest to read.
  .au-card.rc-band
    h1.au-page__title= t('buttons.forgot_password')

    = render ErrorsComponent.new(object: resource, tone: :site)

    = form_for(resource, as: resource_name, url: password_path(resource_name),
               html: { method: :post, class: 'au-form' }) do |f|
      .au-field
        = f.label :email, class: 'au-label'
        = f.email_field :email, autofocus: true, autocomplete: 'email', class: 'au-input'

      = f.submit t('buttons.send_reset_password'), class: 'rc-button rc-button--primary'

    p.au-aside= link_to t('buttons.sign_in'), new_session_path(resource_name), class: 'hover-link'
