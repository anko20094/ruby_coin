/ A password input with its reveal button inside the field. Locals: f, field, autocomplete,
/ autofocus (optional).
.au-input-row[data-controller="password-visibility"
              data-password-visibility-show-label-value=t('labels.show_password')
              data-password-visibility-hide-label-value=t('labels.hide_password')]
  = f.password_field field, autocomplete: autocomplete, autofocus: local_assigns.fetch(:autofocus, false),
    class: 'au-input au-input--with-reveal', data: { password_visibility_target: 'input' }
  button.au-reveal[type="button" aria-pressed="false" aria-label=t('labels.show_password')
                   title=t('labels.show_password')
                   data-action="password-visibility#toggleVisibility" data-password-visibility-target="toggle"]
    / Eye while hidden, crossed-out eye while shown — the icon says what pressing it will do.
    svg.au-reveal__icon.au-reveal__icon--show[viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"]
      path[d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"]
      circle[cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.6"]
    svg.au-reveal__icon.au-reveal__icon--hide[viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"]
      path[d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"]
      circle[cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.6"]
      path[d="M4 4 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"]
