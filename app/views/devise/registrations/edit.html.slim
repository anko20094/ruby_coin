- content_for :title, full_title(t('labels.edit_account'))

.au-page
  h1.au-page__title= t('labels.edit_account')

  = render ErrorsComponent.new(object: resource, tone: :site)

  = form_for(resource, as: resource_name, url: registration_path(resource_name),
             html: { method: :put, class: 'au-form' }) do |f|
    .au-field
      = f.label :email, class: 'au-label'
      = f.email_field :email, autocomplete: 'email', class: 'au-input'

    .au-field
      = f.label :nickname, class: 'au-label'
      = f.text_field :nickname, autocomplete: 'nickname', class: 'au-input'

    .au-field
      = f.label :password, class: 'au-label'
      .au-hint= t('.leave_blank')
      = render 'devise/shared/password_input', f: f, field: :password, autocomplete: 'new-password'

    .au-field
      = f.label :password_confirmation, class: 'au-label'
      = render 'devise/shared/password_input', f: f, field: :password_confirmation, autocomplete: 'new-password'

    .au-field
      = f.label :current_password, class: 'au-label'
      .au-hint= t('.confirm_notice')
      = render 'devise/shared/password_input', f: f, field: :current_password, autocomplete: 'current-password'

    = f.submit t('buttons.update'), class: 'rc-button rc-button--primary'
