- content_for :title, full_title(t('contact.show.title'))
- page_meta description: t('contact.show.lede')

.ct-page
  header.ct-page__header
    .ct-page__intro
      .rc-eyebrow= "/#{t('contact.show.eyebrow')}"
      h1.ct-page__title
        = t('contact.show.title')
        = ' '
        span.ct-page__mark ·
    / The anchor lines up with the heading, not with the lede — the lede sits below the
    / whole header, as in the prototype.
    .ct-page__anchor
      = render GemComponent.new(uid: 'contact-anchor', variant: :anchor, size: 90)

  p.ct-page__lede= t('contact.show.lede')

  / Whole rows are links, so keyboard and middle-click work (handoff §11).
  .ct-channels
    - @profile.contact_rows.each do |key, label, href|
      = link_to href, class: 'ct-channel', target: '_blank', rel: 'noreferrer' do
        span.ct-channel__key= key
        span.ct-channel__value= label
        span.ct-channel__arrow aria-hidden="true" →

  .ct-where
    .ct-where__row
      span.ct-where__key= t('profile.location')
      span.ct-where__value= @profile.location
    .ct-where__row
      span.ct-where__key= t('profile.languages')
      span.ct-where__value= @profile.languages
