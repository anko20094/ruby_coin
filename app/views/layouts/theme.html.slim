doctype html
html lang=I18n.locale
  head
    meta charset="utf-8"
    = favicon_link_tag asset_path('favicon.ico')
    title
      = content_for?(:title) ? yield(:title) : 'RubyCoin'

    meta[name="viewport" content="width=device-width,initial-scale=1"]
    = csrf_meta_tags
    = csp_meta_tag
    / The four faces are self-hosted (theme/_fonts.scss) — no runtime request to
    / Google Fonts. Preload only the slices the first paint actually needs.
    - theme_preloaded_faces.each do |face|
      link rel="preload" href=asset_path("#{face}.woff2") as="font" type="font/woff2" crossorigin=""
    = stylesheet_link_tag 'theme', media: 'all'
    = javascript_include_tag 'theme', defer: true

  body.rc-site
    = render NavComponent.new
    main.rc-main.page-in
      = yield
    = render FooterComponent.new
