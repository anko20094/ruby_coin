/ Lookbook renders components inside this, so previews carry the real theme —
/ tokens, self-hosted faces and all. A nav without its stylesheet tells you
/ nothing.
doctype html
html lang=I18n.locale
  head
    meta charset="utf-8"
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    - theme_preloaded_faces.each do |face|
      link rel="preload" href=asset_path("#{face}.woff2") as="font" type="font/woff2" crossorigin=""
    = stylesheet_link_tag 'theme', media: 'all'
    = javascript_include_tag 'theme', defer: true
  body.rc-site
    = yield
