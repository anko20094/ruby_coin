- content_for :title, full_title(t('studio.show.title'))
- page_meta description: t('studio.show.lede')

.st-page
  header.rc-header
    .rc-header__intro
      .rc-eyebrow= "/#{t('studio.show.eyebrow')}"
      h1.rc-header__title
        = t('studio.show.title')
        = ' '
        span.rc-header__mark ·
      p.rc-header__lede= t('studio.show.lede')
    .rc-header__anchor
      = render GemComponent.new(uid: 'studio-anchor', variant: :anchor, size: 90)

  / The same roster as /team at a lower density — one file, two pages, so a new person is one
  / entry rather than three edits.
  .st-crew
    - @people.each do |person|
      = link_to person_path(person), class: 'st-card' do
        = render MonogramComponent.of(person, size: 88, ring: :mute)
        .st-card__body
          h2.st-card__name= person.name
          .st-card__meta
            span.st-card__role= person.role
            / The same chip the roster card carries. This page introduces the six as "who is
            / here today", so a record with invented dates has to say so here too.
            - if person.placeholder?
              span.tm-card__chip.is-placeholder= t('profile.placeholder_chip')
            - elsif person.draft?
              span.tm-card__chip= t('profile.draft')
          p.st-card__blurb= rich(person.blurb)
          .st-card__link
            = "#{t('studio.show.cv_link')} "
            span aria-hidden="true" →
