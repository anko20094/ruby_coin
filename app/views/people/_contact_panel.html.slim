/ Every row here is optional, and a CV nobody has filled in yet has none of them. The panel is
/ a bordered box, so rendering it empty draws a frame around nothing — it is drawn only when it
/ has something in it.
- rows = cv.contact_rows
- facts = { location: cv.location, languages: cv.languages, education: cv.education }.reject { |_, value| value.blank? }

- if rows.any? || facts.any?
  .pf-contact
    - if rows.any?
      .pf-contact__label.is-ruby= t('profile.contact')
    - rows.each do |key, label, href|
      .pf-contact__row
        span.pf-contact__key= key
        = link_to label, href, class: 'pf-contact__value', target: '_blank', rel: 'noreferrer'
    - facts.each do |key, value|
      .pf-contact__label= t("profile.#{key}")
      div= rich(value)
