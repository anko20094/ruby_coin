/ cases_by_slug is empty on a person page: the projects are the "worked on" list below it, and
/ the same links twice on one page is a list pretending to be two.
- cases_by_slug = local_assigns.fetch(:cases_by_slug, {})

section.pf-block.pf-block--career
  = render TrackTagComponent.new(label: t('profile.career'), tone: :soft, heading: :h2)
  .pf-career
    - cv.experience.each do |entry|
      .pf-career__entry
        .pf-career__head
          / A heading, not a div: these are the sections of a CV, and heading navigation is how
          / a screen-reader user skims one.
          h3.pf-career__org
            = rich(entry[:org])
            - if entry[:title].present?
              span.pf-career__title
                = ' · '
                = rich(entry[:title])
          .pf-career__when
            = entry[:period]
            - if entry[:place].present?
              br
              = rich(entry[:place])
        - if entry[:note].present?
          .pf-career__note= rich(entry[:note])
        - if entry[:body].present?
          .pf-career__body= rich(entry[:body])
        - entry_cases = entry[:case_slugs].filter_map { |slug| cases_by_slug[slug] }
        - if entry_cases.any?
          / What stops the CV and the project list from being the same page twice: the entry
          / states the job, the chips point at the evidence.
          .pf-career__cases
            - entry_cases.each do |kase|
              = link_to work_case_path(slug: kase.slug), class: 'rc-chip rc-chip--link hover-link' do
                = "#{kase.mark} #{plain(kase.title)} "
                span aria-hidden="true" →
