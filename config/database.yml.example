# Copy to config/database.yml (git-ignored). The defaults match the `dev` role the README creates;
# set DB_* in .env to use another one. DATABASE_URL, when set (CI does), overrides all of this.
default: &default
  adapter: postgresql
  username: <%= ENV.fetch('DB_USERNAME', 'dev') %>
  password: <%= ENV.fetch('DB_PASSWORD', 'dev') %>
  host: <%= ENV.fetch('DB_HOST', 'localhost') %>
  port: <%= ENV.fetch('DB_PORT', 5432) %>
  encoding: utf8
  reconnect: true
  pool: <%= ENV.fetch('RAILS_MAX_THREADS', 5) %>

development:
  <<: *default
  database: ruby_coin_development

test:
  <<: *default
  database: ruby_coin_test
