# Copy to .env (git-ignored); dotenv loads it in development and test.

# --- database (read by config/database.yml.example) -----------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dev
DB_PASSWORD=dev

# --- bin/rails db:seed ----------------------------------------------------------------------
# Development and test fall back to the defaults below and print a generated password.
# Outside them seeding needs ALLOW_SEED=1 and both SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD.
# SEED_ADMIN_EMAIL=admin@rubyco.in
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NICKNAME=danyil
# ALLOW_SEED=

# --- production only ------------------------------------------------------------------------
# dotenv is a development/test gem, so production reads these from the process environment
# (the systemd unit), not from this file. Listed here so they are written down somewhere.
# APP_HOST=rubyco.in
# FORCE_SSL=1
# MAILER_FROM=no-reply@rubyco.in
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- tools ----------------------------------------------------------------------------------
# CHROME_BIN=        # rake og:cards, when Chrome/Chromium is not on PATH
